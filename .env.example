# Copy this file to .env for local testing with `vercel dev`.
# In production, set this in the Vercel dashboard instead (see README) —
# never commit the real key to git.

GOOGLE_API_KEY=your-google-cloud-api-key-here

# Optional — see README "Part D". If left unset, both checks below are
# silently skipped (no rate limiting / no shared-secret check). Also
# powers the usage counters read by /api/stats (README "Part E").
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
APP_SECRET=

# Required to view /api/stats at all (unlike APP_SECRET above, missing
# this does NOT fail open — see README "Part E"). Must be a DIFFERENT
# value from APP_SECRET: that one ships inside the app bundle, this one
# must never leave your own notes / the Vercel dashboard.
STATS_SECRET=
